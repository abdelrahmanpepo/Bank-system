#ifndef PERSON_H
#define PERSON_H

#include <iostream>
#include <string>

using namespace std;

class Person 
{
protected:
    int id;
    string name;
    string password;

public:
    Person();
    Person(int id, string name, string password);

    // Getters
    int getId() const;
    string getName() const;
    string getPassword() const;

    // Setters
    void setId(int id);
    virtual void setName(string name);
    virtual void setPassword(string password);

    // Display
    virtual void display() const;
};

#endif
